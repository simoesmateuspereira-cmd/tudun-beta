# Modelo sem segredos. Use somente dados fictícios no ambiente local.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
# Se vazio, manage.py usa .postgres-recovered/ quando existir; senão, .postgres/.
DATABASE_URL=
DATABASE_TIME_ZONE=GMT
DATABASE_CONN_MAX_AGE=0

# E-mail local. Na homologação, a API HTTPS do Gmail evita portas SMTP bloqueadas.
# Preencha as três variáveis GMAIL somente no .env local e nos campos secretos do Render.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
EMAIL_BACKEND=django.core.mail.backends.filebased.EmailBackend
DEFAULT_FROM_EMAIL=tudun-teste@localhost
EMAIL_HOST=localhost
EMAIL_PORT=25
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=10
EMAIL_VERIFICATION_MAX_AGE=172800

# Sem CACHE_URL, o cache em memória atende somente um processo local.
# Exemplo externo: CACHE_URL=rediss://:senha@host:porta/0
CACHE_URL=
CACHE_KEY_PREFIX=tudun
DJANGO_REQUIRE_SHARED_CACHE=False
DJANGO_REQUIRE_SMTP=False
RATELIMIT_ENABLE=True
RATELIMIT_USE_CACHE=default

# Hospedagem: envie logs ao stdout; localmente, mantenha o arquivo rotativo.
LOG_TO_FILE=True

# HTTPS externo: ativar somente com domínio, proxy e certificado validados.
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
DJANGO_TRUST_PROXY_SSL=False

# Reservado para etapas futuras; storage R2 não foi implementado.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT_URL=
